<?xml version="1.0"?>
<!--
  inertial_macros.xacro
  Reusable inertia macros so every link gets a physically plausible inertia
  tensor. Wrong/zero inertias are the #1 cause of robots that "explode" or
  sink through the floor in Gazebo, so we compute them from primitive shapes.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * mass * (x*x + z*z)}" iyz="0.0"
        izz="${(1.0/12.0) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}" iyz="0.0"
        izz="${(1.0/2.0) * mass * (radius*radius)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2.0/5.0) * mass * (radius*radius)}" ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0) * mass * (radius*radius)}" iyz="0.0"
        izz="${(2.0/5.0) * mass * (radius*radius)}"/>
    </inertial>
  </xacro:macro>

</robot>

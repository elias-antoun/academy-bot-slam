<?xml version="1.0"?>
<!--
  sensors.xacro
  The exteroceptive sensors AcadBot uses for SLAM:
    * 2D LiDAR  (gpu_lidar)  -> /scan      : LiDAR SLAM (slam_toolbox)
    * RGBD cam  (rgbd_camera)-> /camera/*   : Visual SLAM session
    * IMU       (imu)        -> /imu        : sensor-fusion discussions
  All three are Gazebo Harmonic (gz-sim 8) sensors. The world must load the
  Sensors + Imu systems for them to publish (see acadbot_gazebo world file).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================= -->
  <!-- 2D LiDAR                                                       -->
  <!-- ============================================================= -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.035">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.05 0 ${0.10 + 0.02}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ============================================================= -->
  <!-- RGBD camera (for the Visual SLAM session)                      -->
  <!-- ============================================================= -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.03" y="0.08" z="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${0.30/2} 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame: REP-103 says optical frames are x-right, y-down, z-forward. -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============================================================= -->
  <!-- IMU                                                            -->
  <!-- ============================================================= -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="grey"/>
    </visual>
    <xacro:inertial_box mass="0.01" x="0.02" y="0.02" z="0.01">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>

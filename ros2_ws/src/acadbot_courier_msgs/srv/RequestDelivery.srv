# RequestDelivery.srv
# Book a delivery between two named locations.
#
# This is a SERVICE, not an action, because booking is a transaction: it either
# succeeds or it does not, it takes no measurable time, and there is nothing to
# report while it happens. The reply comes back immediately — the driving is
# done afterwards through the ExecuteDelivery action, using the job_id below.
#
# Locations are named, never coordinates. The courier resolves each name
# against the table in its YAML config and freezes the resulting pose into the
# job, so a later parameter change cannot move the target of a booked job.

string pickup       # named location; must exist in the courier's location table
string dropoff      # named location; must exist, and must differ from pickup
---
bool   accepted
string job_id       # refer to this when sending the ExecuteDelivery goal;
                    # empty when accepted is false
string reason       # why it was rejected, in words meant for a human;
                    # empty when accepted is true

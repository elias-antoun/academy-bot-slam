  <version>1.0.0</version>
  <description>Nav2 configuration, maps and launch (with recovery behaviors) for AcadBot.</description>
  <maintainer email="wael.alsayegh@inmind.ai">Wael Al Sayegh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>acadbot_slam</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
